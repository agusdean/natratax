# ========================================================
# NatraTax — School Tax & Financial Administration System
# Target Organization: SMK BINA PUTRA JAKARTA
# Environment Configuration Template
# ========================================================

APP_NAME="NatraTax"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

# Multi-Tenant & School Defaults
DEFAULT_TENANT_ID="00000000-0000-0000-0000-000000000001"
DEFAULT_SCHOOL_NAME="SMK BINA PUTRA JAKARTA"
DEFAULT_SCHOOL_NPWP="998866000010609"

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=natratax_db
DB_USERNAME=natratax_user
DB_PASSWORD=YourSecurePasswordHere

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# File Storage
FILESYSTEM_DISK=local

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@natratax.binaputra.sch.id"
MAIL_FROM_NAME="NatraTax SMK Bina Putra"

# Object Storage (S3-compatible)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-southeast-1
S3_BUCKET=natratax-documents

# NatraTax AI Assistant Service
AI_API_KEY=your_gemini_or_internal_ai_key_here
AI_MODEL="gemini-2.0-flash"
