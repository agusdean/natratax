# ========================================================
# NatraTax — School Tax & Financial Administration System
# Target Organization: SMK BINA PUTRA JAKARTA
# Environment Configuration Template (Neon DB & Cloudinary & Vercel)
# ========================================================

# Public Next.js Variables (Exposed to browser)
NEXT_PUBLIC_APP_NAME="NatraTax"
NEXT_PUBLIC_SITE_URL="https://natratax.vercel.app"
NEXT_PUBLIC_API_URL="/api/v1"
NEXT_PUBLIC_DEFAULT_NPWP="9988770000010609"

# --------------------------------------------------------
# 1. NEON SERVERLESS POSTGRESQL DATABASE
# Ambil dari Neon Console (https://console.neon.tech)
# --------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:YourPassword@ep-cool-forest-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
PGHOST="ep-cool-forest-123456.us-east-2.aws.neon.tech"
PGDATABASE="neondb"
PGUSER="neondb_owner"
PGPASSWORD="YourPassword"

# --------------------------------------------------------
# 2. CLOUDINARY CLOUD STORAGE (Faktur, SPJ, Bukti NTPN)
# Ambil dari Cloudinary Dashboard (https://cloudinary.com/console)
# --------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@your_cloud_name"

# --------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (Server-Only)
# --------------------------------------------------------
JWT_SECRET="generate_random_64_character_hex_secret_here"
ADMIN_MIGRATION_KEY="natratax_secure_migration_key_2026"

# --------------------------------------------------------
# 4. OPTIONAL AI ASSISTANT SERVICE
# --------------------------------------------------------
AI_API_KEY="your_gemini_or_internal_ai_key"
AI_MODEL="gemini-2.0-flash"
